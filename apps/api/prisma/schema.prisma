generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String

  projects  Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id])

  agents    Agent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id          String @id @default(cuid())

  name        String
  provider    String
  model       String

  projectId   String
  project     Project @relation(fields: [projectId], references: [id])

  createdAt   DateTime @default(now())
}

model ApiKey {
  id          String @id @default(cuid())

  provider    String
  key         String

  createdAt   DateTime @default(now())
}